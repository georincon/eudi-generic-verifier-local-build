# Copiar a .env (lo hace scripts/preparar-entorno.sh). .env esta en .gitignore.

# Puertos del anfitrion (libres frente a los stacks existentes)
VERIFIER_HOST_PORT=8480
VERIFIER_DB_HOST_PORT=5437
# 127.0.0.1 = solo esta maquina. Use 0.0.0.0 unicamente si lo necesita y entiende el riesgo.
VERIFIER_BIND_ADDRESS=127.0.0.1

# URL publica. En local:        http://localhost:8480
# Detras del dominio compartido: https://civica-desarrollo.avance.org.co/verifier
VERIFIER_PUBLICURL=http://localhost:8480

# UID/GID con los que corre el contenedor (deben poder leer secretos/pki, que es 600)
LOCAL_UID=1000
LOCAL_GID=1000
